# Copy to .env; this file contains examples, not real credentials.
# Replace with a local password using letters, digits, hyphens or underscores.
# Compose inserts this into a PostgreSQL URL; avoid URL-reserved characters.
POSTGRES_PASSWORD=local-development-only-change-me

# Only localhost is exposed. Change host ports if already occupied.
POSTGRES_PORT=5432
DASHBOARD_PORT=8501
AIRFLOW_PORT=8080
WEB_PORT=8000

# The discovery document supplies individual feed URLs.
GBFS_DISCOVERY_URL=https://toronto.publicbikesystem.net/customer/gbfs/v3.0/gbfs.json

# TTC collector: poll intervals (subway predictions and vehicle positions, then alerts)
# and how long to keep raw protobuf (vehicle positions in hours, as each snapshot is
# ~130 KB) and per-train history.
TTC_FAST_POLL_SECONDS=10
TTC_POLL_SECONDS=30
TTC_RAW_RETENTION_DAYS=3
TTC_VEHICLE_RAW_RETENTION_HOURS=6
TTC_EVENT_RETENTION_DAYS=90

# Phone alerts (docs/alerts.md): an ntfy topic URL with a hard-to-guess name, and an
# optional dead man's switch URL (e.g. healthchecks.io) pinged every minute.
# NTFY_URL=https://ntfy.sh/transit-alerts-replace-with-random-text
# HEARTBEAT_URL=https://hc-ping.com/your-check-uuid

# Public site: requests per minute per client address to /api/.
WEB_RATE_LIMIT_PER_MINUTE=120
# Trip plans per minute per client address to /api/plan (docs/planner.md).
WEB_PLAN_RATE_LIMIT_PER_MINUTE=20

# Separate collector server (docs/collector.md): SSH target, port, private key and
# known_hosts file used by the server-tunnel service on the development machine.
# COLLECTOR_SSH=user@203.0.113.7
# COLLECTOR_SSH_PORT=22
# COLLECTOR_SSH_KEY=C:/Users/you/.ssh/collector_key
# COLLECTOR_KNOWN_HOSTS=C:/Users/you/.ssh/known_hosts

# Production only (compose.prod.yaml; see docs/deploy.md).
# Public hostname for HTTPS, e.g. a free <ip-with-dashes>.sslip.io name or your domain.
# SITE_ADDRESS=203-0-113-7.sslip.io
# Password for the site's read-only database login (created by init-db).
# WEB_DB_PASSWORD=change-me
# Days of daily database dumps to keep in ./backups.
# BACKUP_KEEP_DAYS=7
# Behind an existing reverse proxy (compose.proxied.yaml): this machine's LAN address,
# where the site listens, and the proxy's LAN address, the only one trusted to forward.
# WEB_BIND=192.0.2.10
# PROXY_IP=192.0.2.20
